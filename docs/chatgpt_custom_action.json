{
  "openapi": "3.1.0",
  "info": {
    "title": "QueryCraft Universal Database AI Engine",
    "description": "Agentic database connection, schema introspection, natural language SQL generation, and live query execution.",
    "version": "1.5.0"
  },
  "servers": [
    {
      "url": "https://ttsc-jet.vercel.app",
      "description": "QueryCraft Live Production Engine"
    }
  ],
  "paths": {
    "/api/workspaces/connect": {
      "post": {
        "summary": "Connect Database to Workspace",
        "description": "Links and introspects a live PostgreSQL, Supabase, Neon, RDS, or MongoDB Atlas database directly into the user's workspace.",
        "operationId": "connectDatabase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["connection_uri"],
                "properties": {
                  "connection_uri": {
                    "type": "string",
                    "description": "The database connection string (e.g. postgresql://user:password@db.supabase.co:5432/postgres)"
                  },
                  "workspace_name": {
                    "type": "string",
                    "default": "Production",
                    "description": "Target workspace (Production, Staging, Analytics)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connection status and introspected tables",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "message": { "type": "string" },
                    "host": { "type": "string" },
                    "database": { "type": "string" },
                    "tables_count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/clarification/schema": {
      "get": {
        "summary": "Inspect Database Tables & Schema",
        "description": "Returns the database tables, column data types, foreign keys, and relations.",
        "operationId": "getDatabaseSchema",
        "responses": {
          "200": {
            "description": "Database schema and table structures",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "database_type": { "type": "string" },
                    "tables": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "table_name": { "type": "string" },
                          "description": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/clarification": {
      "post": {
        "summary": "Ask Database Question in Plain English",
        "description": "Translates any natural language prompt into safe, grounded SQL queries.",
        "operationId": "generateSqlQuery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_prompt"],
                "properties": {
                  "user_prompt": {
                    "type": "string",
                    "description": "Natural language question or request"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated SQL query and explanation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "message": { "type": "string" },
                    "extracted_data": {
                      "type": "object",
                      "properties": {
                        "sql_query": { "type": "string" },
                        "dialect": { "type": "string" },
                        "explanation": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/database/execute": {
      "post": {
        "summary": "Execute SQL Query and Return Result Rows",
        "description": "Executes a read-only SQL query against the database and returns the actual data rows, column names, and row count.",
        "operationId": "executeDatabaseQuery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sql_query"],
                "properties": {
                  "sql_query": {
                    "type": "string",
                    "description": "The read-only SQL query to execute"
                  },
                  "connection_uri": {
                    "type": "string",
                    "description": "Optional direct database connection URI"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Executed query data rows and columns",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "columns": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "row_count": { "type": "integer" },
                    "execution_time_ms": { "type": "number" },
                    "was_healed": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
